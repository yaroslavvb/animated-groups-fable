Cell["*\[Times] \[CenterDot] cm", "Subsection",ExpressionUUID->"6c338dce-d002-4375-ba43-14ec98bfc522"],

Cell["\<\
Manipulate[
  Column[{FG$bar[\"cm\"],
          Dynamic@FilmGroupFrame[FG$cm[FG$pick[\"cm\"]], t, {660, 300}]},
   Center, 1],
  {{t, 0, \"t\"}, 0, 1, ControlType -> Animator, AnimationRate -> 1/4,
